    {
      "id": "pain",
      "title": "先把操作理顺",
      "short": "3 秒看懂问题",
      "from": 0,
      "end": 180,
      "heading": [
        "资料、任务、直播进度，",
        "怎么接起来？"
      ],
      "caption": "不用来回找，把操作变成一条清楚的路径。"
    },
    {
      "id": "flow",
      "title": "看懂工作流程",
      "short": "四个环节，一条路径",
      "from": 180,
      "end": 540,
      "heading": [
        "先准备任务，",
        "再跟随现场进度。"
      ],
      "caption": "上传资料，自动分析，按企业编排，再安排执行。"
    },
    {
      "id": "compare",
      "title": "选择准备方式",
      "short": "新资料 / 现成任务",
      "from": 540,
      "end": 900,
      "heading": [
        "有新资料，生成。",
        "有完整任务，复用。"
      ],
      "caption": "两条路径都保存在本地，完整任务可导出交接。"
    },
    {
      "id": "install",
      "title": "安装与打开",
      "short": "四格并行 → 融合工作台",
      "from": 900,
      "end": 1020,
      "heading": [
        "四个安装动作，",
        "压缩成一次启动。"
      ],
      "caption": "安装过程为压缩示意，实际操作请按下方图文步骤完成。"
    },
    {
      "id": "json",
      "title": "导入 JSON",
      "short": "更多 → 导入任务",
      "from": 1020,
      "end": 1380,
      "heading": [
        "同事编好的任务，",
        "拿过来就能用。"
      ],
      "caption": "导入后，当前任务与企业节点一起更新。"
    },
    {
      "id": "excel",
      "title": "从 Excel 新建",
      "short": "设置场次，上传生成",
      "from": 1380,
      "end": 1860,
      "heading": [
        "新资料，",
        "从 Excel 开始。"
      ],
      "caption": "保存 Key 后设置场次，上传资料即可生成并保存。"
    },
    {
      "id": "case",
      "title": "安排一场直播",
      "short": "60 分钟 · 300 位用户",
      "from": 1860,
      "end": 2340,
      "heading": [
        "提前准备好，",
        "到点按计划执行。"
      ],
      "caption": "示例场次；预约期间保持浏览器与目标页面运行。"
    },
    {
      "id": "control",
      "title": "现场调整",
      "short": "跟随主播切换企业",
      "from": 2340,
      "end": 2820,
      "heading": [
        "主播讲到哪家，",
        "就切到哪家。"
      ],
      "caption": "前序未处理内容会跳过，已处理内容不重复发送。"
    },
    {
      "id": "outro",
      "title": "记住这一句",
      "short": "准备任务，跟上进度",
      "from": 2820,
      "end": 3180,
      "heading": [
